{
  "expo": {
    "name": "Aftertouch",
    "slug": "aftertouch-app",
    "scheme": "aftertouch",
    "version": "0.5.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#111111"
    },
    "android": {
      "package": "berlin.spengler.aftertouch.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111111"
      },
      "usesCleartextTraffic": true,
      "permissions": [
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/splash.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "./plugins/withCleartextTraffic",
      "expo-asset",
      "./plugins/withForcedVibration"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png"
  }
}
